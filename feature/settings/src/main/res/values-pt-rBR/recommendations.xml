<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Library > LeaveMeAlone: switches for the optional suggestion sections. Names match the section titles people see in the app. -->
    <!-- Subtext of the LeaveMeAlone row on Library and on Appearance > Home, both opening the same page. -->
    <string name="recommendations_row_description">Desative as recomendações em todo o app</string>
    <string name="recommendations_home_title">No Início</string>
    <!-- "Explore shows" is the charts grid at the bottom of Home. Off sections make no requests, so they do not load. -->
    <string name="recommendations_home_footer">Cards de destaque, Seus podcasts e Explorar podcasts sempre ficam. As seções que você desativar não carregam.</string>
    <!-- The Brief is the daily audio news briefing card. Off is the same choice as the card's Always hide. -->
    <string name="recommendations_brief">O Brief</string>
    <string name="recommendations_brief_description">Um resumo diário curto em áudio</string>
    <string name="recommendations_picked_for_you">Escolhidos para você</string>
    <!-- Turning it off also removes the For you tab from Explore, which shows the same picks. -->
    <string name="recommendations_picked_for_you_description">Episódios com base no que você ouve. Desativar também remove Para você de Explorar.</string>
    <string name="recommendations_because_you_like">Porque você curte</string>
    <string name="recommendations_because_you_like_description">Podcasts e episódios parecidos com um que você ouve</string>
    <!-- The rows under the greeting that changes through the day: Good Morning, Afternoon Break, Evening Unwind, Late Night Listen. -->
    <string name="recommendations_time_of_day">Sugestões por horário</string>
    <string name="recommendations_time_of_day_description">Fileiras que mudam ao longo do dia, como Bom dia</string>
    <string name="recommendations_episodes_title">Nas páginas de episódios</string>
    <!-- The episode pages' similar-episodes section is titled "Try these episodes" there. Off makes no request. -->
    <string name="recommendations_more_like_this">Experimente estes episódios</string>
    <string name="recommendations_more_like_this_description">Episódios parecidos no fim de cada página de episódio</string>
    <!-- Shows hidden from a show page with Hide show everywhere; Unhide lets boxlore suggest them again. -->
    <string name="recommendations_hidden_title">Podcasts ocultos</string>
    <string name="recommendations_hidden_footer">Podcasts ocultos ficam fora do Início, de Explorar, do Lore e da Fila inteligente. Encontrar podcast ainda os encontra.</string>
    <string name="recommendations_hidden_empty">Nenhum podcast oculto</string>
    <!-- "Hide show everywhere" is the show page menu item, quoted as it reads there. -->
    <string name="recommendations_hidden_empty_description">Para ocultar um, abra o podcast e escolha Ocultar podcast em todo lugar no menu.</string>
    <!-- A hidden show whose name wasn't saved. -->
    <string name="recommendations_hidden_unknown">Podcast desconhecido</string>
    <string name="recommendations_hidden_unhide">Mostrar</string>
    <!-- Screen reader label of a row's Unhide button; %1$s is the show's name. -->
    <string name="recommendations_hidden_unhide_description">Mostrar %1$s</string>
</resources>
