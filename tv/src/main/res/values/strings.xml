    <!-- TV sign-in, the TV's first screen until it is signed in: the TV shows a code that the listener enters in boxlore on their phone. -->
    <string name="tv_sign_in_title">Sign in with your phone</string>
    <string name="tv_account_body">boxlore on this TV uses your account: your shows, listening progress and likes come from your phone and stay in step.</string>
    <!-- Three numbered steps beside the code. "Settings", "Cloud Sync & Backups" and "Sign in on a TV" name the phone app's own pages and button (feature/settings: settings_page_sync, account_tv_sign_in). "Your account" is the account card at the top of Cloud Sync & Backups ("Sync is on"), which opens Account & sync, where the button is. -->
    <string name="tv_sign_in_step_open">On your phone, open boxlore.</string>
    <string name="tv_sign_in_step_choose">Go to Settings › Cloud Sync &amp; Backups, open your account, and choose Sign in on a TV.</string>
    <string name="tv_sign_in_step_enter">Enter the code shown here.</string>
    <string name="tv_your_code">Your code</string>
    <string name="tv_signed_in">Signed in</string>
    <string name="tv_getting_code">Getting a code…</string>
    <string name="tv_code_refreshes">The code changes every 10 minutes. This screen signs in by itself once you enter it.</string>
    <!-- After a few codes ran out with nobody entering one, the TV stops asking for more until the listener chooses Show a new code. -->
    <string name="tv_code_ran_out">The code ran out</string>
    <string name="tv_code_ran_out_body">Get a new one when your phone is ready.</string>
    <string name="tv_new_code">Show a new code</string>
    <string name="tv_sign_in_failed">Couldn\'t reach boxlore. Check the TV\'s internet connection.</string>
    <!-- boxlore has paused signing in new TVs (a switch on boxlore's side); TVs already signed in keep working. -->
    <string name="tv_sign_in_closed">Signing in on a TV is paused for now. Try again later.</string>
    <!-- The API limits how many codes this TV and its network may ask for, per minute and per day; the TV waited out a short limit once, and doesn't wait out a long one. -->
    <string name="tv_too_many_codes">Too many codes were asked for lately. Try again later.</string>
    <!-- A phone approved the code, but it hadn't passed boxlore's quick check (Cloudflare's, on the phone), so the TV couldn't sign in with it. -->
    <string name="tv_phone_check_title">Your phone needs a quick check</string>
    <string name="tv_phone_check_body">Show a new code and enter it on your phone. If boxlore there asks for a quick check, finish it so this TV can sign in.</string>
    <string name="tv_try_again">Try again</string>
    <string name="tv_search_failed">Couldn\'t search. Check the TV\'s internet connection.</string>
    <!-- The account this TV is signed in to, e.g. "Signed in as listener@example.com" -->
    <string name="tv_signed_in_as">Signed in as %1$s</string>
    <string name="tv_signed_in_body">Your shows, listening progress and likes stay in step with your account.</string>
