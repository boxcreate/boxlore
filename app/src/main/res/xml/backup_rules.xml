<?xml version="1.0" encoding="utf-8"?>
<!--
   Sample backup rules file; see https://developer.android.com/about/versions/12/backup-restore#encrypted-backups
   for more reference.
-->
<full-backup-content>
    <!-- SharedPreferences + Room restore; DataStore lives under files/datastore. -->
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore/" />
    <!-- Rebuild WorkManager jobs from DataStore instead of restoring stale schedules. -->
    <exclude domain="database" path="androidx.work.workdb" />
    <exclude domain="database" path="androidx.work.workdb-journal" />
    <exclude domain="database" path="androidx.work.workdb-wal" />
    <exclude domain="database" path="androidx.work.workdb-shm" />
</full-backup-content>
