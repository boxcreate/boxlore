        <item quantity="one">Marcar %d podcast como ouvido</item>
        <item quantity="other">Marcar %d podcasts como ouvidos</item>
    </plurals>
    <string name="import_fresh_skip">Manter tudo como não ouvido</string>

    <!-- Library import: done. -->
    <string name="import_done_title">Seus podcasts chegaram</string>
    <!-- Shown instead of import_done_title when no show could be added yet but boxlore keeps trying to add them. -->
    <string name="import_done_title_pending">Adicionando seus podcasts</string>
    <string name="import_done_backup_title">Seu backup foi restaurado</string>
    <string name="import_done_body">Tudo pronto quando você quiser.</string>
    <!-- Shown instead of import_done_body when some OPML shows couldn't be added yet; boxlore keeps adding them while it is open. -->
    <plurals name="import_done_body_pending">
        <item quantity="one">%d podcast não pôde ser adicionado agora. O boxlore continua tentando enquanto estiver aberto.</item>
        <item quantity="other">%d podcasts não puderam ser adicionados agora. O boxlore continua tentando enquanto estiver aberto.</item>
    </plurals>
    <!-- A label under the count, which is shown on its own; the singular is right for 0 and 1 here. -->
    <plurals name="import_done_subscribed" tools:ignore="ImpliedQuantity">
        <item quantity="one">podcast seguido</item>
        <item quantity="other">podcasts seguidos</item>
    </plurals>
    <string name="import_done_marked">marcados como ouvidos</string>
    <string name="import_notify_body">Alguns podcasts têm alertas ou downloads automáticos. Eles precisam de notificações para funcionar.</string>
    <string name="import_notify_allow">Permitir notificações</string>
    <string name="import_notify_settings">Abrir configurações</string>
    <string name="import_continue">Continuar</string>

