# Sub-projects (local only)
# STRICTLY LOCAL: everything under admin-panel/ stays ignored except the public composer files
# listed below. Never un-ignore its README/runbook, gateway, config.json, crypto.js, Firebase
# project files (.firebaserc, firebase.json, database.rules.json, .firebase/), data backups, or
# hosting, domain and deployment notes. Add new public files one by one, never a whole folder.
admin-panel/*
!admin-panel/public/
admin-panel/public/*
!admin-panel/public/notifyappusers/
admin-panel/public/notifyappusers/*
!admin-panel/public/notifyappusers/dashboard.html
!admin-panel/public/notifyappusers/dashboard.js
!admin-panel/public/notifyappusers/composer.css
!admin-panel/public/notifyappusers/preview.html
!admin-panel/public/notifyappusers/announcements/
admin-panel/public/notifyappusers/announcements/*
!admin-panel/public/notifyappusers/announcements/font.ttf
!admin-panel/public/notifyappusers/announcements/renderer.css
!admin-panel/public/notifyappusers/announcements/renderer.html
!admin-panel/public/notifyappusers/announcements/renderer.js
telemetry-worker/

