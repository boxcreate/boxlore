    <string name="episode_list_time_left_hours">%1$d h %2$d min restantes</string>
    <!-- As above, under an hour: %1$d minutes left. -->
    <string name="episode_list_time_left_minutes">%1$d min restantes</string>
    <!-- Subtitle under the episode title in the episode options sheet. -->
    <string name="episode_options_title">Options de l’épisode</string>
