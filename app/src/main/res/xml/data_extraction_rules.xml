<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/auto_download_background.preferences_pb" />
        <!-- The API session is bound to this phone's Keystore key; a restored copy could never renew. -->
        <exclude domain="file" path="datastore/boxlore_api_session.preferences_pb" />
        <!-- Update offers and installation sessions belong to this device only. -->
        <exclude domain="sharedpref" path="boxlore_direct_updates.xml" />
        <exclude domain="sharedpref" path="boxlore_play_updates.xml" />
        <exclude domain="sharedpref" path="boxlore_test_updates.xml" />
        <exclude domain="sharedpref" path="boxlore_update_session.xml" />
        <exclude domain="sharedpref" path="boxlore_test_update_session.xml" />
        <!-- The note of a listen in progress belongs to this run; restored, it would report a cut-off listen again. -->
        <exclude domain="sharedpref" path="boxlore_listen_note.xml" />
        <!-- This install's own first play; a restored copy would hide the new phone's first play. -->
        <exclude domain="sharedpref" path="boxlore_install_milestones.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-journal" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
        <exclude domain="file" path="datastore/auto_download_background.preferences_pb" />
        <!-- The API session is bound to this phone's Keystore key; a restored copy could never renew. -->
        <exclude domain="file" path="datastore/boxlore_api_session.preferences_pb" />
        <!-- Update offers and installation sessions belong to this device only. -->
        <exclude domain="sharedpref" path="boxlore_direct_updates.xml" />
        <exclude domain="sharedpref" path="boxlore_play_updates.xml" />
        <exclude domain="sharedpref" path="boxlore_test_updates.xml" />
        <exclude domain="sharedpref" path="boxlore_update_session.xml" />
        <exclude domain="sharedpref" path="boxlore_test_update_session.xml" />
        <!-- The note of a listen in progress belongs to this run; restored, it would report a cut-off listen again. -->
        <exclude domain="sharedpref" path="boxlore_listen_note.xml" />
        <!-- This install's own first play; a restored copy would hide the new phone's first play. -->
        <exclude domain="sharedpref" path="boxlore_install_milestones.xml" />
        <exclude domain="database" path="androidx.work.workdb" />
        <exclude domain="database" path="androidx.work.workdb-journal" />
        <exclude domain="database" path="androidx.work.workdb-wal" />
        <exclude domain="database" path="androidx.work.workdb-shm" />
    </device-transfer>
</data-extraction-rules>
