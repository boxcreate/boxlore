<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Library > LeaveMeAlone: switches for the optional suggestion sections. Names match the section titles people see in the app. -->
    <!-- Subtext of the LeaveMeAlone row on Library and on Appearance > Home, both opening the same page. -->
    <string name="recommendations_row_description">Désactiver les recommandations dans toute l’appli</string>
    <string name="recommendations_home_title">Sur l’accueil</string>
    <!-- "Explore shows" is the charts grid at the bottom of Home. Off sections make no requests, so they do not load. -->
    <string name="recommendations_home_footer">Les cartes à la une, Vos podcasts et Explorer les podcasts restent toujours. Les sections désactivées ne se chargent pas.</string>
    <!-- The Brief is the daily audio news briefing card. Off is the same choice as the card's Always hide. -->
    <string name="recommendations_brief">Le Brief</string>
    <string name="recommendations_brief_description">Un court brief audio quotidien</string>
    <string name="recommendations_picked_for_you">Choisis pour vous</string>
    <!-- Turning it off also removes the For you tab from Explore, which shows the same picks. -->
    <string name="recommendations_picked_for_you_description">Des épisodes basés sur vos écoutes. Le désactiver retire aussi Pour vous de l’onglet Explorer.</string>
    <string name="recommendations_because_you_like">Parce que vous aimez</string>
    <string name="recommendations_because_you_like_description">Des podcasts et épisodes proches de ceux que vous écoutez</string>
    <!-- The rows under the greeting that changes through the day: Good Morning, Afternoon Break, Evening Unwind, Late Night Listen. -->
    <string name="recommendations_time_of_day">Suggestions selon l’heure</string>
    <string name="recommendations_time_of_day_description">Des rangées qui changent au fil de la journée, comme Bonjour</string>
    <string name="recommendations_episodes_title">Sur les pages d’épisode</string>
    <!-- The episode pages' similar-episodes section is titled "Try these episodes" there. Off makes no request. -->
    <string name="recommendations_more_like_this">Essayez ces épisodes</string>
    <string name="recommendations_more_like_this_description">Des épisodes similaires en bas de chaque page d’épisode</string>
    <!-- Shows hidden from a show page with Hide show everywhere; Unhide lets boxlore suggest them again. -->
    <string name="recommendations_hidden_title">Podcasts masqués</string>
    <string name="recommendations_hidden_footer">Les podcasts masqués n’apparaissent pas dans Accueil, Explorer, Lore ni la File d’attente intelligente. Ils restent accessibles via Trouver un podcast.</string>
    <string name="recommendations_hidden_empty">Aucun podcast masqué</string>
    <!-- "Hide show everywhere" is the show page menu item, quoted as it reads there. -->
    <string name="recommendations_hidden_empty_description">Pour en masquer un, ouvrez le podcast et choisissez Masquer le podcast partout dans son menu.</string>
    <!-- A hidden show whose name wasn't saved. -->
    <string name="recommendations_hidden_unknown">Podcast inconnu</string>
    <string name="recommendations_hidden_unhide">Ne plus masquer</string>
    <!-- Screen reader label of a row's Unhide button; %1$s is the show's name. -->
    <string name="recommendations_hidden_unhide_description">Ne plus masquer %1$s</string>
</resources>
