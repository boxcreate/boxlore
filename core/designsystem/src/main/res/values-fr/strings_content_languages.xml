<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Joining names into a list, built from the end: "German, French and Spanish" is list_middle(German, list_end_and(French, Spanish)). -->
    <string name="list_middle">%1$s, %2$s</string>
    <string name="list_end_and">%1$s et %2$s</string>
    <string name="list_end_or">%1$s ou %2$s</string>

    <!-- The content languages sheet (Library settings › Recommendations › Languages). -->
    <string name="content_languages_title">Langues</string>
    <!-- Beside the title: how many languages are picked. %1$d is the number picked, %2$d the most allowed (4). -->
    <string name="content_languages_picked">%1$d sur %2$d choisies</string>
    <string name="content_languages_include_english">Inclure l’anglais</string>
    <!-- Heading over language chips. %1$s is a country or region name, such as Germany. -->
    <string name="content_languages_suggested_for">Suggestions pour : %1$s</string>
    <string name="content_languages_other">Autres langues</string>
    <string name="content_languages_done">OK</string>
    <!-- Under "Include English" when it is off and one language is picked. %1$s is that language's name as used inside a sentence (German, allemand). -->
    <string name="content_languages_english_off_one">Il y a beaucoup moins de podcasts en %1$s, donc les recommandations correspondront moins bien à vos goûts. S’il n’y en a pas assez, boxlore en ajoute quelques-uns en anglais.</string>
    <string name="content_languages_english_off_many">Il y a beaucoup moins de podcasts dans vos langues, donc les recommandations correspondront moins bien à vos goûts. S’il n’y en a pas assez, boxlore en ajoute quelques-uns en anglais.</string>
    <!-- %1$s is a list of language names, such as "German and French". -->
    <string name="content_languages_english_can_turn_off">Désactivez-le pour n’avoir que des podcasts en %1$s.</string>
    <!-- %1$s lists the picked languages that keep English on ("Hindi and Chinese"); %2$s lists the languages that can stand alone, joined with "or". -->
    <string name="content_languages_english_kept_on">Reste activé avec : %1$s. Vous pourrez le désactiver si vous ne choisissez que : %2$s.</string>
    <!-- %1$s lists the languages that can stand alone, joined with "or". -->
    <string name="content_languages_english_only">Vous pourrez le désactiver si vous ne choisissez que : %1$s.</string>

    <!-- The content region picker, shared by settings and onboarding. -->
    <string name="content_region_label">Région du contenu</string>
    <string name="content_region_supporting">Classements et tendances régionales</string>
    <string name="content_region_choose">Choisir la région du contenu</string>
    <string name="content_region_sheet_body">Définit les classements dans Explorer. Vos langues ne changent pas.</string>
    <!-- Under a country in the picker. %1$s lists that country's suggested languages, such as "English · Hindi". -->
    <string name="content_region_suggested">Suggérées : %1$s</string>
</resources>
