<?xml version="1.0" encoding="utf-8"?>
<!--
  New Episodes: a tinted block with the count in a scalloped badge and each episode as a pill row.
  The list stops short of the rounded bottom corners, so rows are cut on a straight edge.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault.DayNight">

    <FrameLayout
        android:id="@+id/widget_list_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_surface_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:src="@drawable/widget_container" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/widget_header_row"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginHorizontal="14dp"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_count_chip"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_count_chip_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_cookie" />

                    <TextView
                        android:id="@+id/widget_count_chip_text"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@color/widget_on_primary"
                        android:textSize="19sp" />
                </FrameLayout>

                <TextView
                    android:id="@+id/widget_list_header"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:autoSizeMaxTextSize="20sp"
                    android:autoSizeMinTextSize="13sp"
                    android:autoSizeStepGranularity="0.5sp"
                    android:autoSizeTextType="uniform"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center_vertical"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_surface" />

                <FrameLayout
                    android:id="@+id/widget_open_list"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/widget_open_list_background"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_circle" />

                    <ImageView
                        android:id="@+id/widget_open_list_icon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:autoMirrored="true"
                        android:contentDescription="@string/library_widget_view_all"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_widget_arrow_forward" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_list_content"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <ListView
                    android:id="@+id/widget_list_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="14dp"
                    android:divider="@null"
                    android:dividerHeight="0dp"
                    android:scrollbars="none" />

                <LinearLayout
                    android:id="@+id/widget_empty_container"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/widget_empty_mark"
                        android:layout_width="72dp"
                        android:layout_height="72dp">

                        <ImageView
                            android:id="@+id/widget_empty_mark_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_cookie" />

                        <ImageView
                            android:id="@+id/widget_empty_icon"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_widget_caught_up" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/widget_empty_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:textColor="@color/widget_on_surface"
                        android:textSize="17sp" />

                    <FrameLayout
                        android:id="@+id/widget_empty_cta_chip"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginTop="12dp"
                        android:minWidth="120dp">

                        <ImageView
                            android:id="@+id/widget_empty_cta_bg"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_pill" />

                        <TextView
                            android:id="@+id/widget_empty_cta"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:paddingHorizontal="22dp"
                            android:textColor="@color/widget_on_surface"
                            android:textSize="14sp" />
                    </FrameLayout>
                </LinearLayout>
            </FrameLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
