<?xml version="1.0" encoding="utf-8"?>
<!--
  Now Playing · Full Controls, regular shape: an info pill over a pill, play button, pill row. The
  frame is never taller for its width than the design allows and sits in the middle of the cell. The
  two rows share its height by weight and every part inside them is a proportion of its row, so the
  widget fits whatever space the launcher gives it. The root is transparent: the wallpaper shows
  between the shapes. Transport controls keep their sides in right-to-left layouts, so they use
  left and right on purpose. The empty views are spacers: a widget cannot use Space.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    tools:ignore="RtlHardcoded,NestedWeights,UselessLeaf">

    <RelativeLayout
        android:id="@+id/widget_frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_frame_sizer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:src="@drawable/widget_sizer_frame" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_alignStart="@id/widget_frame_sizer"
            android:layout_alignTop="@id/widget_frame_sizer"
            android:layout_alignEnd="@id/widget_frame_sizer"
            android:layout_alignBottom="@id/widget_frame_sizer">

            <LinearLayout
                android:id="@+id/widget_playing_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <FrameLayout
                    android:id="@+id/widget_info"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/widget_surface_background"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/widget_pill" />

                    <LinearLayout
                        android:id="@+id/widget_info_content"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:baselineAligned="false"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="22dp"
                        android:paddingBottom="4dp">

                        <RelativeLayout
                            android:id="@+id/widget_disc"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent">

                            <ImageView
                                android:id="@+id/widget_disc_sizer"
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:adjustViewBounds="true"
                                android:contentDescription="@null"
                                android:src="@drawable/widget_sizer_square" />

                            <ImageView
                                android:id="@+id/widget_progress_track"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_alignStart="@id/widget_disc_sizer"
                                android:layout_alignTop="@id/widget_disc_sizer"
                                android:layout_alignEnd="@id/widget_disc_sizer"
                                android:layout_alignBottom="@id/widget_disc_sizer"
                                android:contentDescription="@null"
                                android:scaleType="fitXY" />

                            <ImageView
                                android:id="@+id/widget_progress"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_alignStart="@id/widget_disc_sizer"
                                android:layout_alignTop="@id/widget_disc_sizer"
                                android:layout_alignEnd="@id/widget_disc_sizer"
                                android:layout_alignBottom="@id/widget_disc_sizer"
                                android:contentDescription="@null"
                                android:scaleType="fitXY" />

                            <ImageView
                                android:id="@+id/widget_artwork_placeholder"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_alignStart="@id/widget_disc_sizer"
                                android:layout_alignTop="@id/widget_disc_sizer"
                                android:layout_alignEnd="@id/widget_disc_sizer"
                                android:layout_alignBottom="@id/widget_disc_sizer"
                                android:contentDescription="@null"
                                android:scaleType="fitXY"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/widget_artwork_mark"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_alignStart="@id/widget_disc_sizer"
                                android:layout_alignTop="@id/widget_disc_sizer"
                                android:layout_alignEnd="@id/widget_disc_sizer"
                                android:layout_alignBottom="@id/widget_disc_sizer"
                                android:contentDescription="@null"
                                android:scaleX="0.42"
                                android:scaleY="0.42"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_boxlore_app_mark"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/widget_artwork"
                                android:layout_width="0dp"
                                android:layout_height="0dp"
                                android:layout_alignStart="@id/widget_disc_sizer"
                                android:layout_alignTop="@id/widget_disc_sizer"
                                android:layout_alignEnd="@id/widget_disc_sizer"
                                android:layout_alignBottom="@id/widget_disc_sizer"
                                android:contentDescription="@null"
                                android:scaleType="fitXY" />
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/widget_metadata_container"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingVertical="5dp">

                            <TextView
                                android:id="@+id/widget_episode_title"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="3"
                                android:autoSizeMaxTextSize="15sp"
                                android:autoSizeMinTextSize="12sp"
                                android:autoSizeStepGranularity="0.5sp"
                                android:autoSizeTextType="uniform"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif-medium"
                                android:gravity="bottom|start"
                                android:includeFontPadding="false"
                                android:maxLines="2"
                                android:textColor="@color/widget_on_primary_container" />

                            <TextView
                                android:id="@+id/widget_podcast_title"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="2"
                                android:autoSizeMaxTextSize="12sp"
                                android:autoSizeMinTextSize="10sp"
                                android:autoSizeStepGranularity="0.5sp"
                                android:autoSizeTextType="uniform"
                                android:ellipsize="end"
                                android:fontFamily="sans-serif"
                                android:gravity="top|start"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:paddingTop="2dp"
                                android:textColor="@color/widget_on_primary_container" />
                        </LinearLayout>
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/widget_controls"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_weight="1"
                    android:baselineAligned="false"
                    android:layoutDirection="ltr"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginRight="8dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_controls_start_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_pill" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp">

                            <FrameLayout
                                android:id="@+id/widget_previous"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="42">

                                <ImageView
                                    android:id="@+id/widget_previous_icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/widget_previous"
                                    android:scaleX="0.5"
                                    android:scaleY="0.5"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_widget_previous" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/widget_skip_back"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="58">

                                <ImageView
                                    android:id="@+id/widget_skip_back_background"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:scaleX="0.9"
                                    android:scaleY="0.9"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/widget_circle" />

                                <ImageView
                                    android:id="@+id/widget_skip_back_icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/widget_skip_back"
                                    android:scaleX="0.4"
                                    android:scaleY="0.4"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_widget_skip_back" />
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>

                    <RelativeLayout
                        android:id="@+id/widget_play_pause"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/widget_play_pause_sizer"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:adjustViewBounds="true"
                            android:contentDescription="@null"
                            android:src="@drawable/widget_sizer_square" />

                        <ImageView
                            android:id="@+id/widget_play_pause_background"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_alignStart="@id/widget_play_pause_sizer"
                            android:layout_alignTop="@id/widget_play_pause_sizer"
                            android:layout_alignEnd="@id/widget_play_pause_sizer"
                            android:layout_alignBottom="@id/widget_play_pause_sizer"
                            android:contentDescription="@null"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_cookie" />

                        <ImageView
                            android:id="@+id/widget_play_pause_icon"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_alignStart="@id/widget_play_pause_sizer"
                            android:layout_alignTop="@id/widget_play_pause_sizer"
                            android:layout_alignEnd="@id/widget_play_pause_sizer"
                            android:layout_alignBottom="@id/widget_play_pause_sizer"
                            android:contentDescription="@string/widget_play"
                            android:scaleX="0.44"
                            android:scaleY="0.44"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_widget_play" />
                    </RelativeLayout>

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginLeft="8dp"
                        android:layout_weight="1">

                        <ImageView
                            android:id="@+id/widget_controls_end_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/widget_pill" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:paddingHorizontal="6dp">

                            <FrameLayout
                                android:id="@+id/widget_skip_forward"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="58">

                                <ImageView
                                    android:id="@+id/widget_skip_forward_background"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@null"
                                    android:scaleX="0.9"
                                    android:scaleY="0.9"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/widget_circle" />

                                <ImageView
                                    android:id="@+id/widget_skip_forward_icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/widget_skip_forward"
                                    android:scaleX="0.4"
                                    android:scaleY="0.4"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_widget_skip_fwd" />
                            </FrameLayout>

                            <FrameLayout
                                android:id="@+id/widget_next"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="42">

                                <ImageView
                                    android:id="@+id/widget_next_icon"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:contentDescription="@string/widget_next"
                                    android:scaleX="0.5"
                                    android:scaleY="0.5"
                                    android:scaleType="fitCenter"
                                    android:src="@drawable/ic_widget_next" />
                            </FrameLayout>
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_empty_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/widget_empty_surface_background"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_pill" />

                <LinearLayout
                    android:id="@+id/widget_empty_content"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="20dp">

                    <FrameLayout
                        android:id="@+id/widget_empty_mark"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="38">

                        <ImageView
                            android:id="@+id/widget_empty_mark_background"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleX="0.74"
                            android:scaleY="0.74"
                            android:scaleType="fitCenter"
                            android:src="@drawable/widget_cookie" />

                        <ImageView
                            android:id="@+id/widget_empty_icon"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleX="0.33"
                            android:scaleY="0.33"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_widget_play" />
                    </FrameLayout>

                    <LinearLayout
                        android:id="@+id/widget_empty_text"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="6dp"
                        android:layout_weight="62"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="2" />

                        <TextView
                            android:id="@+id/widget_empty_title"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="3"
                            android:autoSizeMaxTextSize="18sp"
                            android:autoSizeMinTextSize="11sp"
                            android:autoSizeStepGranularity="0.5sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="bottom|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/widget_on_primary_container" />

                        <TextView
                            android:id="@+id/widget_empty_subtitle"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="2"
                            android:autoSizeMaxTextSize="12.5sp"
                            android:autoSizeMinTextSize="9.5sp"
                            android:autoSizeStepGranularity="0.5sp"
                            android:autoSizeTextType="uniform"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif"
                            android:gravity="top|start"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:paddingTop="2dp"
                            android:textColor="@color/widget_on_primary_container" />

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="2" />
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
    </RelativeLayout>
</FrameLayout>
