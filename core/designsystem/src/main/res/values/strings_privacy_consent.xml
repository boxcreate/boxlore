    <string name="privacy_consent_why_body" translatable="false">The data shared helps us improve the product by understanding user behaviour. No user-specific targeted personalization will be done, and no data collected will ever be user-identifiable.</string>
    <string name="privacy_consent_view_data" translatable="false">View Data Collected</string>
    <string name="privacy_consent_data_crash_title" translatable="false">Crash Reports</string>
    <string name="privacy_consent_data_crash_body" translatable="false">Stack traces, device state, and crash logs to identify stability issues.</string>
    <string name="privacy_consent_data_usage_title" translatable="false">Usage Statistics</string>
    <string name="privacy_consent_data_usage_body" translatable="false">Events such as play, subscribe, search, screen views, and playback state.</string>
    <string name="privacy_consent_agree_all" translatable="false">Agree to All</string>
    <string name="privacy_consent_agree_all_body" translatable="false">Enables Crash Reporting, Usage Analytics, and accepts Privacy Policy.</string>
    <string name="privacy_consent_individual" translatable="false">Individual Settings</string>
