<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Daily brief screen. Story text, titles and sources come from the server and are not translated. -->
    <!-- Above the story pager, e.g. "Story 2 of 6". -->
    <string name="briefing_screen_story_position">Noticia %1$d de %2$d</string>
    <string name="briefing_screen_previous_story">Noticia anterior</string>
    <string name="briefing_screen_next_story">Noticia siguiente</string>
    <string name="briefing_screen_stories_loading">Cargando noticias…</string>
    <string name="briefing_screen_stories_unavailable">El texto de las noticias no está disponible. Aun así puedes escuchar el resumen.</string>
    <!-- Header of the related episodes under a story. -->
    <string name="briefing_screen_listen_further">Para saber más</string>
    <!-- Time left in the brief; the argument is a length such as "3m". -->
    <string name="briefing_screen_time_left">Quedan %1$s</string>
    <!-- The brief's length in the header line, e.g. "4 min listen". -->
    <plurals name="briefing_screen_listen_minutes">
        <item quantity="one">%1$d min de escucha</item>
        <item quantity="many">%1$d min de escucha</item>
        <item quantity="other">%1$d min de escucha</item>
    </plurals>
    <!-- Episode description of the brief in the player; the argument is the region code, e.g. "US". -->
    <string name="briefing_screen_episode_description">Tu resumen diario de noticias generado con IA para %1$s.</string>
    <!-- Heading above the brief's source links in the episode description. -->
    <string name="briefing_screen_sources_heading">Referencias y fuentes</string>
    <!-- TalkBack name of the Brief's seek bar. -->
    <string name="briefing_screen_seek_name">Posición de reproducción</string>
    <!-- TalkBack position on the seek bar: where playback is, then the Brief's length, e.g. "12:03 of 58:00". -->
    <string name="briefing_screen_seek_position">%1$s de %2$s</string>
</resources>
