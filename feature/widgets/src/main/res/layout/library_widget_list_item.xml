<?xml version="1.0" encoding="utf-8"?>
<!--
  One Your Shows tile. The artwork (or its placeholder) is a square bitmap already cut to its shape,
  and adjustViewBounds makes the tile as tall as the column is wide. The dot marks a new episode.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/widget_row_art_placeholder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitXY"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_row_art_mark"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_boxlore_app_mark"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_row_art"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_row_new_dot_ring"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_row_new_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="3dp"
            android:layout_marginEnd="3dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_circle"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
