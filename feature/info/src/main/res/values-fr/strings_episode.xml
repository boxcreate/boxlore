    <string name="episode_info_license_cc">Creative Commons %1$s</string>
    <string name="episode_info_license_cc_generic">Licence Creative Commons</string>
    <string name="episode_info_license_all_rights">Tous droits réservés</string>
    <string name="episode_info_license_public_domain">Domaine public</string>
