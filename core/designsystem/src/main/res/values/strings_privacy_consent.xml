    <string name="privacy_consent_usage_toggle" translatable="false">Usage Statistics (Optional)</string>
    <string name="privacy_consent_usage_toggle_body" translatable="false">Share anonymous interaction data to help us identify popular features.</string>
    <string name="privacy_consent_policy" translatable="false">Privacy Policy</string>
    <string name="privacy_consent_policy_agree" translatable="false">I have read and agree to the Privacy Policy</string>
    <string name="privacy_consent_read_policy" translatable="false">Read Policy</string>
    <string name="privacy_consent_accept" translatable="false">Accept &amp; Continue</string>
