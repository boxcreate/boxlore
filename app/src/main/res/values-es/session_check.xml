<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown only when Cloudflare's check needs the listener to confirm they are a person. It can
         open on any screen: as boxlore starts, on Home, in onboarding, or before something like
         feedback or sync goes through, when the phone's own check (Google Play) can't vouch for
         it. Echo says the title beside its picture (Echo is a robot, hence the joke); the check
         itself (a box drawn by Cloudflare) sits below the body. -->
    <string name="session_check_title">Soy el único robot que puede usar esta app.</string>
    <string name="session_check_body">Toca la casilla para que Cloudflare compruebe que eres una persona. Así los bots se quedan fuera de boxlore.</string>
    <!-- Closes the check. boxlore carries on with what works without it (in onboarding, topics or
         charts instead of AI suggestions). -->
    <string name="session_check_skip">Omitir</string>
</resources>
